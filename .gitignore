# ── 真实凭证:绝不进仓库 ───────────────────────────────────────────
# bots.env     飞书 App ID / App Secret(两个机器人各一对)+ provider 的 key
# bots9.env    9 个 codex 机器人的 App ID / App Secret(make-bots9-env.py 生成)
# providers.toml 几十个中转站的 api_key,80KB
# 两者都在本机重新生成,做法见 README「密钥从哪来」。仓库里永远不该有它们。
bots.env
bots9.env
providers.toml

# ── 可重新获取的缓存 ───────────────────────────────────────────────
# cc-connect 上游源码克隆(20MB)。.verify-models-heartbeat.sh 与 .verify-skill.sh
# 拿它跟真实实现比对,所以本机验证时需要它,但它不该进仓库 —— 见 README 的重建命令。
.cache/

# ── agent 探测产物 ────────────────────────────────────────────────
.probe-agents/

# ── 验证脚本的运行产物 ─────────────────────────────────────────────
# .verify-restore.sh 会造一个 /workspace 的假沙盒跑 restore-all.sh,
# .verify-clash.sh 会把 clash-install.sh 的路径改成临时目录再跑,
# .verify-bootstrap.sh 会造仓库副本验判台逻辑,.verify-b64cmd/ 存 base64 中间结果;
# .verify-agent-proxy.sh 造仿造的 config.toml 验增删代理段的对称性;
# .verify-bots9.sh 造仿造的 config.toml + 假会话目录,验 9 机器人克隆与白名单回填;
# 都是可重跑出来的。
.verify-b64cmd/
.verify-restore/
.verify-bootstrap/
.verify-tmp/
.verify-agent-proxy/
.verify-bots9/
# .verify-inspect.sh:仿造 config.toml + jobs.json + cc.log,跑通巡检脚本的每条分支
# (含"认错台"守卫),断言失败时夹具会留下来供查看
.verify-inspect/

# python 的字节码缓存:验证脚本里 py_compile 那一步若不重定向就会留一个(已重定向,
# 这里兜底,免得以后再踩)
__pycache__/

# ── 无人引用的本机探针快照 ─────────────────────────────────────────
# 一份中转站 /v1/models 的响应,全目录检索零引用。
.models.json
